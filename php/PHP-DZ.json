function processPrices(array $prices, float $maxPrice, float $discount): array
{
    $result = [];

    foreach ($prices as $price) {
        if ($price > $maxPrice) {
            continue; // пропускаем всё, что СТРОГО выше лимита
        }
        $result[] = round($price * (1 - $discount / 100), 2);
    }

    return $result;
}


function analyzeWeather(array $temperatures): array
{
    return [
        'avg'         => round(array_sum($temperatures) / count($temperatures), 1),
        'max'         => max($temperatures),
        'min'         => min($temperatures),
        'frosty_days' => count(array_filter($temperatures, fn($t) => $t < 0)),
    ];
}

$prices = [100.50, 2500, 300, 6000, 999.99];
print_r(processPrices($prices, 1000, 15));

$weather = [5, -3, 0, 12, -7, 4];
print_r(analyzeWeather($weather));

