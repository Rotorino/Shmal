<?php

class Wallet
{
    private string $currency;   // скрытые свойства — напрямую снаружи не изменить
    private float $balance;

    public function __construct(string $currency, float $balance = 0)
    {
        $this->currency = $currency;
        $this->balance  = $balance;
    }

    public function getBalance(): float
    {
        return $this->balance;
    }

    public function getCurrency(): string
    {
        return $this->currency;
    }

    public function deposit(float $amount): void
    {
        $this->balance += $amount;
    }

    public function withdraw(float $amount): void
    {
        if ($amount > $this->balance) {
            echo "Недостаточно средств!" . PHP_EOL;
            return; // баланс не трогаем
        }
        $this->balance -= $amount;
    }
}

$wallet = new Wallet('RUB');          // баланс по умолчанию 0
echo $wallet->getBalance() . PHP_EOL; // 0

$wallet->deposit(1500);
echo $wallet->getBalance() . PHP_EOL; // 1500

$wallet->withdraw(2000);              // Недостаточно средств!
echo $wallet->getBalance() . PHP_EOL; // всё ещё 1500

$wallet->withdraw(500);
echo $wallet->getBalance() . PHP_EOL; // 1000

// echo $wallet->balance; // Fatal error - свойство private

