<?php

//  Интерфейсы 
{
    public function calculateDeliveryCost(): float;
}

interface WarrantyInterface
{
    public function getWarrantyPeriod(): int;
}

//  Абстрактный родитель 
abstract class Product
{
    protected string $title;
    protected float $price;

    public function __construct(string $title, float $price)
    {
        $this->title = $title;
        $this->price = $price;
    }

    public function getTitle(): string
    {
        return $this->title;
    }

    public function getPrice(): float
    {
        return $this->price;
    }

    // Каждый наследник считает финальную цену по-своему
    abstract public function getFinalPrice(): float;
}

//  Наследники 
class DigitalProduct extends Product
{
    public function getFinalPrice(): float
    {
        return $this->price * 0.9; // скидка 10%
    }
}

class PhysicalProduct extends Product implements DeliverableInterface
{
    public function calculateDeliveryCost(): float
    {
        return $this->price > 5000 ? 0 : 300; // дороже 5000 — доставка бесплатна
    }

    public function getFinalPrice(): float
    {
        return $this->price;
    }
}

class ElectronicsProduct extends Product implements DeliverableInterface, WarrantyInterface
{
    private int $weight;

    public function __construct(string $title, float $price, int $weight)
    {
        parent::__construct($title, $price); // базовые свойства инициализирует родитель
        $this->weight = $weight;
    }

    public function calculateDeliveryCost(): float
    {
        return $this->weight * 200; // 200 за кг
    }

    public function getWarrantyPeriod(): int
    {
        return 24;
    }

    public function getFinalPrice(): float
    {
        return $this->price;
    }
}

//  Отчёт 
$cart = [
    new DigitalProduct('Курс по PHP', 2000),
    new PhysicalProduct('Книга «Чистый код»', 800),
    new ElectronicsProduct('Ноутбук', 50000, 3),
];

foreach ($cart as $item) {
    echo 'Название: ' . $item->getTitle() . PHP_EOL;
    echo 'Финальная стоимость: ' . $item->getFinalPrice() . ' руб.' . PHP_EOL;

    if ($item instanceof DeliverableInterface) {
        echo 'Доставка: ' . $item->calculateDeliveryCost() . ' руб.' . PHP_EOL;
    } else {
        echo 'Доставка: Доставка не требуется' . PHP_EOL;
    }

    if ($item instanceof WarrantyInterface) {
        echo 'Гарантия: ' . $item->getWarrantyPeriod() . ' мес.' . PHP_EOL;
    }

    echo str_repeat('-', 40) . PHP_EOL;
}


