<?php

trait LoggerTrait
{
    public function log(string $message): void
    {
        echo '[' . date('Y-m-d H:i:s') . '] ' . $message . PHP_EOL;
    }
}

trait TimestampTrait
{
    protected ?DateTimeImmutable $createdAt = null;

    abstract public function getTitle(): string;

    public function getInfo(): string
    {
        $this->createdAt ??= new DateTimeImmutable(); // запоминаем дату при первом вызове
        return 'Объект: ' . $this->getTitle()
             . ', создан: ' . $this->createdAt->format('d.m.Y H:i:s');
    }
}

class User
{
    use LoggerTrait;
    use TimestampTrait;

    private string $name;

    public function __construct(string $name)
    {
        $this->name = $name;
    }

    public function getTitle(): string
    {
        return $this->name;
    }
}

class Product
{
    use LoggerTrait;
    use TimestampTrait;

    private string $title;

    public function __construct(string $title)
    {
        $this->title = $title;
    }

    public function getTitle(): string
    {
        return $this->title;
    }
}

// Проверка работы 
$user    = new User('Иван Петров');
$product = new Product('Ноутбук ASUS');

echo $user->getInfo() . PHP_EOL;      // Объект: Иван Петров, создан: 24.08.2026 ...
echo $product->getInfo() . PHP_EOL;   // Объект: Ноутбук ASUS, создан: ...

$user->log('Пользователь вошёл в систему');   // [2026-08-24 14:03:11] Пользователь...
$product->log('Товар добавлен на склад');

