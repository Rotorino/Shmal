<?php
$error = '';
$style = '';

function getComponent(string $value): ?int
{
    if (!is_numeric($value)) {
        return null;
    }
    $v = (int)$value;
    return ($v >= 0 && $v <= 255) ? $v : null;
}

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $r = getComponent($_POST['r'] ?? '');
    $g = getComponent($_POST['g'] ?? '');
    $b = getComponent($_POST['b'] ?? '');

    if ($r === null || $g === null || $b === null) {
        $error = 'Ошибка: все три поля должны содержать числа от 0 до 255!';
    } else {
        $bg = sprintf('#%02x%02x%02x', $r, $g, $b);
        $txt = sprintf('#%02x%02x%02x', 255 - $r, 255 - $g, 255 - $b);

        $style = "background-color: {$bg}; color: {$txt};";
    }
}
