<?php


function validatePassword(string $password): bool
{
    if (mb_strlen($password) < 8) {
        return false;
    }
    if (!preg_match('/\d/', $password)) {          // хотя бы одна цифра
        return false;
    }
    if (!preg_match('/[A-ZА-ЯЁ]/u', $password)) {  // хотя бы одна заглавная
        return false;
    }
    return true;
}


function generateSlug(string $title): string
{
    $map = [
        'а'=>'a','б'=>'b','в'=>'v','г'=>'g','д'=>'d','е'=>'e','ё'=>'e',
        'ж'=>'zh','з'=>'z','и'=>'i','й'=>'y','к'=>'k','л'=>'l','м'=>'m',
        'н'=>'n','о'=>'o','п'=>'p','р'=>'r','с'=>'s','т'=>'t','у'=>'u',
        'ф'=>'f','х'=>'h','ц'=>'ts','ч'=>'ch','ш'=>'sh','щ'=>'sch',
        'ъ'=>'','ы'=>'y','ь'=>'','э'=>'e','ю'=>'yu','я'=>'ya',
        ' '=>'-',
    ];

    $slug = mb_strtolower(trim($title));       // 1. нижний регистр (кириллица!)
    $slug = strtr($slug, $map);                // 2. транслит + пробелы -> '-'
    $slug = preg_replace('/[^a-z0-9\-]/', '', $slug); // 3. убрать пунктуацию
    $slug = preg_replace('/-+/', '-', $slug);  // 4. схлопнуть двойные дефисы
    $slug = trim($slug, '-');                  // 5. убрать '-' по краям

    return $slug;
}

var_dump(validatePassword('qwerty'));            // false — мало символов
var_dump(validatePassword('Password1'));         // true
var_dump(validatePassword('password123'));       // false — нет заглавной

echo generateSlug('Привет, Мир! Как дела?');     // privet-mir-kak-dela
echo PHP_EOL;
echo generateSlug('Ёжик и ЖУК #5');              // ezhik-i-zhuk-5


